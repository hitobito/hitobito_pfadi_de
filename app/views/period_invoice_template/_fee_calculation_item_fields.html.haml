-# This intentionally does not render the shared_item_fields partial, because we want to
-# hide some of the fields such as the unit cost input.

%h3= f.object.class.model_name.human
= f.hidden_field :name, value: f.object.class.model_name.human
= f.hidden_field :unit_cost, name: f.object_name + "[dynamic_cost_parameters][unit_cost]", value: 0
.d-flex.flex-row.gap-2
  = f.input_field :cost_center, placeholder: placeholder(:cost_center), class: "mb-2"
  = f.input_field :account, placeholder: placeholder(:account), class: "mb-2"
