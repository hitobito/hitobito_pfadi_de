- einsichtnahme = EfzEinsichtnahme.new(person: entry)

- if can_create_efz_einsichtnahme?
  = content_for(:toolbar) do
    = action_button(t('people.efz_einsichtnahme_add'), new_group_person_efz_einsichtnahme_path(@group, entry), :plus)

- if entry.latest_efz_issued_on && can_read_efz_einsichtnahme?
  = render_attrs(entry, :latest_efz_issued_on, :latest_efz_einsicht_on)
