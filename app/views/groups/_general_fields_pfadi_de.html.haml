- if entry.attr_used?(:iban)
  = render 'contactable/bank_account_fields', f: f

= f.labeled_input_fields(*entry.used_attributes(:gruendungsdatum, :aufloesungsdatum,
  :einsichtnahme_efz_durch_gruppe, :debitorennummer, :sepa_glaeubiger_id))

= render 'used_i18n_enum_field', attr: :zahlungsart, f:
= render 'used_i18n_enum_field', attr: :rechtsform, f:
= render 'used_i18n_enum_field', attr: :stamm_typ, f:

- if entry.layer? && can?(:modify_superior, entry)
  = f.labeled_inline_fields_for :abbreviations do |nested_f|
    = nested_f.input_field(:value, placeholder: t('.abbreviation_placeholder'), class: 'd-inline')
  = f.indented do
    = f.help_block(t('.help_abbreviations'))

= f.labeled_input_fields(*entry.used_attributes(:strukturnummer, :opt_out_aufnahmeantrag,
  :opt_out_aufnahmeantrag_stammessuche, :efz_in_aufnahmeantrag, :eingeschraenkt))

