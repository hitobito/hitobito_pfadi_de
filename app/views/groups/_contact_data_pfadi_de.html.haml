- billing_info_present = entry.iban.present? || entry.debitorennummer.present? || entry.payment_method.present? || entry.sepa_creditor_id.present?
- if entry.attr_used?(:iban) && billing_info_present
  .contactable.well
    %address
      %strong= t('.bank_account')
      - if entry.bank_account_owner.present?
        %div= entry.bank_account_owner
      - if entry.iban.present?
        %div= entry.iban
      - if entry.bic.present?
        %div= entry.bic
      - if entry.bank_name.present?
        %div= entry.bank_name
      - if entry.debitorennummer.present? or entry.payment_method.present?
        %strong.d-block.mt-2= t('.billing_upwards')
      - if entry.debitorennummer.present?
        %div= "#{entry.class.human_attribute_name(:debitorennummer)}: #{entry.debitorennummer}"
      - if entry.payment_method.present?
        %div= "#{entry.class.human_attribute_name(:payment_method)}: #{entry.payment_method_label}"
      - if entry.sepa_creditor_id.present? or entry.attr_used?(:sepa_mandate_mode)
        %strong.d-block.mt-2= t('.billing_members')
      - if entry.sepa_creditor_id.present?
        %div= "#{entry.class.human_attribute_name(:sepa_creditor_id)}: #{entry.sepa_creditor_id}"
      - if entry.attr_used?(:sepa_mandate_mode)
        %div= "#{entry.class.human_attribute_name(:sepa_mandate_mode)}: #{entry.sepa_mandate_mode_label}"
