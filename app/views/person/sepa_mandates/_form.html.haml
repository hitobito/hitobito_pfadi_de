= entry_form(buttons_top: false, cancel_url: group_person_sepa_mandates_path(@group, parent)) do |f|
  = f.labeled(:group) do
    .form-control-plaintext= creditor.to_s
  = f.labeled(:sepa_creditor_id, Group.human_attribute_name(:sepa_creditor_id)) do
    .form-control-plaintext= creditor.sepa_creditor_id.to_s
  = f.labeled(:bank_account_owner, Person.human_attribute_name(:bank_account_owner)) do
    .form-control-plaintext= parent.bank_account_owner.presence || '-'
  = f.labeled(:iban, Person.human_attribute_name(:iban)) do
    .form-control-plaintext= parent.iban.presence || '-'
  = f.labeled(:bic, Person.human_attribute_name(:bic)) do
    .form-control-plaintext= parent.bic.presence || '-'
  = f.labeled(:bank_name, Person.human_attribute_name(:bank_name)) do
    .form-control-plaintext= parent.bank_name.presence || '-'
  = f.labeled(:issued_at) do
    = f.date_field(:issued_at, value: entry.issued_at && l(entry.issued_at.to_date))
  = f.labeled_boolean_field :user_confirmed_evidence_exists,
    caption: t('.user_confirmed_evidence_exists_caption')
