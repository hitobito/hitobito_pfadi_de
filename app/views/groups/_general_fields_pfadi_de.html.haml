- if entry.modifiable_attributes(:iban).any?
  = render 'contactable/bank_account_fields', f: f

= render 'modifiable_i18n_enum_field', attr: :rechtsform, f:
= render 'modifiable_i18n_enum_field', attr: :stamm_typ, f:
= f.labeled_input_fields(*entry.modifiable_attributes(:strukturnummer, :gruendungsdatum,
  :aufloesungsdatum, :eingeschraenkt))

- billing_upwards_attrs = entry.modifiable_attributes(:debitorennummer, :payment_method)
- if billing_upwards_attrs.any?
  .row
    %h3.form-subtitle.col-12.text-md-start.mt-1= t('.billing_upwards')
  = f.labeled_input_fields(*entry.modifiable_attributes(:debitorennummer))
  = render 'modifiable_i18n_enum_field', attr: :payment_method, f:

- billing_members_attrs = entry.modifiable_attributes(:sepa_creditor_id, :sepa_mandate_mode)
- if billing_members_attrs.any?
  .row
    %h3.form-subtitle.col-12.text-md-start.mt-3= t('.billing_members')
  = f.labeled_input_fields(*entry.modifiable_attributes(:sepa_creditor_id))
  = render 'modifiable_i18n_enum_field', attr: :sepa_mandate_mode, f:

- settings_attrs = entry.modifiable_attributes(:einsichtnahme_efz_durch_gruppe, :opt_out_aufnahmeantrag,
  :opt_out_aufnahmeantrag_stammessuche, :efz_in_aufnahmeantrag)
- if settings_attrs.any?
  .row
    %h3.form-subtitle.col-12.text-md-start.mt-3= t('.settings')
  = f.labeled_input_fields(*settings_attrs)

- if entry.layer? && can?(:modify_superior, entry)
  = f.labeled_inline_fields_for :abbreviations do |nested_f|
    = nested_f.input_field(:value, placeholder: t('.abbreviation_placeholder'), class: 'd-inline')
  = f.indented do
    = f.help_block(t('.help_abbreviations'))
