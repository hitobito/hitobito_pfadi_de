- possible_fee_kinds = FeeKindChooser.new(allow_restricted: can?(:assign_restricted_fee_kinds, role)).possible_for_role(role)
- disabled = !may_change_fee_kind? || possible_fee_kinds.one?
= f.labeled_collection_select(:fee_kind_id,
                              possible_fee_kinds,
                              :id,
                              :name,
                              {},
                              { required: true, class: "form-select form-select-sm", disabled:})
