- title t('.title')

%p= t('.intro')

= table(@prerequisite_changes, class: 'table table-striped') do |t|
  - t.col(Person.model_name.human) { |change| change.role.person.to_s }
  - t.col(Role.model_name.human) { |change| change.role.class.model_name.human }
  - t.col(Group.model_name.human) { |change| change.role.group.decorate.name_with_layer }
  - t.col(t('.previous_period')) { |change| format_prerequisite_period(change.previous_period) }
  - t.col(t('.new_period')) do |change|
    = change.new_period ? format_prerequisite_period(change.new_period) : t('.deleted')

= form_with(url: request.fullpath, method: request.request_method.downcase) do |f|
  = prerequisite_cascade_resubmit_fields
  = hidden_field_tag(:prerequisite_cascade_confirmed, true)
  .btn-toolbar
    = submit_button(f, t('.confirm'))
    = cancel_link(request.referer || root_path)
