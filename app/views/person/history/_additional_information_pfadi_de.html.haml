- if can_read_efz_einsichtnahme?(person)
  %h2= EfzEinsichtnahme.model_name.human(count: 2)
  = table(@efz_einsichtnahmen, class: 'table table-striped table-fixed') do |t|
    - t.attrs(:issued_on, :einsicht_on, :einsichtnehmer)
    - action_col_destroy(t) { |e| group_person_efz_einsichtnahme_path(group, e.person, e) }
