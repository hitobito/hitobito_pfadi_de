- persisted = entry.persisted?
= field_set_tag Role.human_attribute_name(:dates) do
  = f.labeled(:start_on) do
    = f.date_field(:start_on, disabled: persisted && !membership_restrictions.start_on_changeable?, class: 'date col-6', value: f(@role.start_on))
  = f.labeled(:end_on) do
    = f.date_field(:end_on, disabled: !can?(:destroy, @role) || (persisted && !membership_restrictions.end_on_changeable?), class: 'date col-6', value: f(@role.end_on))
