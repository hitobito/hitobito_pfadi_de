- if entry.attr_used?(:iban) && (entry.iban.present? || entry.bank_account_owner.present?)
  .contactable.well
    %address
      %strong= t('.bank_account')
      - if entry.bank_account_owner.present?
        %div= entry.bank_account_owner
      - if entry.iban.present?
        %div= entry.iban
      - if entry.bic.present?
        %div= entry.bic
      - if entry.bank_name.present?
        %div= entry.bank_name
      - if entry.debitorennummer.present?
        %div= "#{entry.class.human_attribute_name(:debitorennummer)}: #{entry.debitorennummer}"
      - if entry.sepa_glaeubiger_id.present?
        %div= "#{entry.class.human_attribute_name(:sepa_glaeubiger_id)}: #{entry.sepa_glaeubiger_id}"
      - if entry.zahlungsart.present?
        %div= entry.class.human_attribute_name("zahlungsart/#{entry.zahlungsart}")
