= render_attrs(entry, :pronoun, :entry_date, :exit_date)

- layer = @group&.layer_group
- if layer.try(:sepa_mandates_enabled?) && can?(:index, SepaMandate.new(person: entry, group: layer))
  = render_attrs_group(labeled(Person.human_attribute_name(:payment_method),
    entry.payment_method_label(layer)))
