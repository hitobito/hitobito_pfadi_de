= field_set_tag do
  -# Overridden from core: :name and :short_name are superior attributes here,
  -# so they are only rendered for people who may modify them.
  = f.labeled_input_fields(*entry.modifiable_attributes(:name, :short_name),
                           disabled: entry.static_name, autocomplete: :off)
  - entry.modifiable_attributes(:description).each do |attr|
    = f.labeled_input_field attr

  = f.labeled(:contact_id) do
    - if @contacts.present?
      = f.select(:contact_id,
                 @contacts.collect { |p| [p.to_s(:list), p.id] },
                 { include_blank: ta(:no_entry) },
                 class: 'form-select form-select-sm')
      = f.help_inline(t('groups.form.help_contact'))
    - else
      %p.text.mt-2= ta(:none_available)

  - if Group.language_labels.many?
    = f.labeled_i18n_enum_field :language, Group.language_labels.to_a, class: 'form-select form-select-sm'

  - if entry.class.attr_used?(:nextcloud_url)
    = f.labeled_input_fields(:nextcloud_url)

  = render 'logo_fields', f: f

  = render 'privacy_policy_fields', f: f

  = render_extensions :general_fields, locals: { f: f }
