%p= @prerequisite_cascade_info
%p= t('prerequisite_cascades.confirm.intro')

= table(@prerequisite_changes, class: 'table table-striped') do |t|
  - t.col(Person.model_name.human) { |change| change.role.person.to_s }
  - t.col(Role.model_name.human) { |change| change.role.class.model_name.human }
  - t.col(Group.model_name.human) { |change| change.role.group.decorate.name_with_layer }
  - t.col(t('prerequisite_cascades.confirm.previous_period')) do |change|
    = format_prerequisite_period(change.previous_period)
  - t.col(t('prerequisite_cascades.confirm.new_period')) do |change|
    - if change.new_period
      = format_prerequisite_period(change.new_period)
    - else
      = t('prerequisite_cascades.confirm.deleted')
